// Poros Enterprise — 核心数据模型（PRD §3.3 概念模型的 Prisma 落地）
// 作用域规则：组织级对象必带 organizationId；项目级对象必带 projectId；
// 用户私有对象带 ownerId。所有跨作用域读取由服务端授权检查（src/server/authz.ts）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BUILDER
  EMPLOYEE
  REVIEWER
}

enum AgentStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum GrantKind {
  TOOL
  SKILL
  MCP
  KNOWLEDGE
  MODEL
}

enum TaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
  // 质量验收状态（审查项⑥）：Judgment FAIL/UNCHECKED 必须体现在最终状态
  SUCCEEDED_WITH_VIOLATIONS
  UNVERIFIED
}

enum ApprovalKind {
  AGENT_PUBLISH
  DANGEROUS_OPERATION
  JUDGMENT_RULE
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum JudgmentStatus {
  CANDIDATE
  APPROVED
  DISABLED
  SUPERSEDED
}

enum EvaluationStatus {
  PASS
  FAIL
  UNCHECKED
}

enum RuleKind {
  MECHANICAL
  SEMANTIC
}

enum ScopeType {
  ORGANIZATION
  DEPARTMENT
  PROJECT
  AGENT
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  members   Membership[]
  projects  Project[]
  agents    AgentDefinition[]
  tasks     Task[]
  files     FileObject[]
  rules     JudgmentRule[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  role           Role
  createdAt      DateTime     @default(now())
  @@unique([organizationId, userId])
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  members        ProjectMember[]
  tasks          Task[]
  files          FileObject[]
  @@unique([organizationId, name])
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  @@unique([projectId, userId])
}

model AgentDefinition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String       @default("")
  department     String       @default("")
  // 草稿配置（JSON）：modelPolicy / toolAllowlist / skillBindings / mcpBindings / knowledgeBindings / output / approvalBoundary
  draftConfig    Json
  // 审查项②：自然语言构建来源留痕（生成该草稿的原始描述；null = 显式表单创建）
  nlSource       String?
  status         AgentStatus  @default(DRAFT)
  currentVersion Int          @default(0)
  versions       AgentVersion[]
  grants         AgentGrant[]
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([organizationId, name])
}

model AgentVersion {
  id           String          @id @default(cuid())
  agentId      String
  agent        AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version      Int
  config       Json // 发布时冻结的不可变快照
  publishedBy  String
  createdAt    DateTime        @default(now())
  applications JudgmentApplication[]
  tasks        Task[]
  @@unique([agentId, version])
}

model AgentGrant {
  id        String    @id @default(cuid())
  agentId   String
  agent     AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind      GrantKind
  name      String // 工具/Skill/MCP/知识/模型 名称
  scopeNote String    @default("") // 来源/版本/授权说明
  createdAt DateTime  @default(now())
  @@unique([agentId, kind, name])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentVersionId String?
  agentVersion   AgentVersion? @relation(fields: [agentVersionId], references: [id], onDelete: SetNull)
  title          String
  prompt         String
  status         TaskStatus   @default(QUEUED)
  createdBy      String
  createdAt      DateTime     @default(now())
  runs           Run[]
  artifacts      Artifact[]
}

model Run {
  id               String   @id @default(cuid())
  taskId           String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status           TaskStatus @default(RUNNING)
  modelGateway     String   @default("mock") // mock | deepseek | ...（未配置真实网关时恒为 mock 并如实标注）
  injectedRules    Json     @default("[]") // 实际注入的 ruleId+version 列表（注入留痕）
  output           String   @default("")
  error            String   @default("")
  startedAt        DateTime @default(now())
  finishedAt       DateTime?
  events           RunEvent[]
  applications     JudgmentApplication[]
}

model RunEvent {
  id        String   @id @default(cuid())
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  kind      String // log|tool_call|judgment|status
  payload   Json
  createdAt DateTime @default(now())
  @@unique([runId, seq])
}

model ApprovalRequest {
  id             String           @id @default(cuid())
  organizationId String
  kind           ApprovalKind
  subjectId      String // agentId / operationId / ruleId
  requestedBy    String
  decision       ApprovalDecision @default(PENDING)
  decidedBy      String?
  createdAt      DateTime         @default(now())
  decidedAt      DateTime?
}

model Artifact {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  taskId         String?
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  name           String
  storageKey     String // S3 对象键（存储桶固定，元数据在此）
  sizeBytes      Int
  sourceUrl      String   @default("") // 来源链接（溯源）
  createdBy      String
  createdAt      DateTime @default(now())
}

model FileObject {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  storageKey     String
  sizeBytes      Int
  sourceUrl      String       @default("")
  createdBy      String
  createdAt      DateTime     @default(now())
}

// Judgment Layer V2（PRD §7）：候选→审批→作用域→注入→验证→生命周期
model JudgmentRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scopeType      ScopeType
  scopeId        String
  sourceRunId    String       @default("")
  sourceFeedback String       @default("") // 用户纠正原文或机器可观测失败摘录
  rule           String
  kind           RuleKind
  status         JudgmentStatus @default(CANDIDATE)
  version        Int          @default(1)
  approvedBy     String?
  createdAt      DateTime     @default(now())
  applications   JudgmentApplication[]
}

model JudgmentApplication {
  id             String         @id @default(cuid())
  ruleId         String
  rule           JudgmentRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleVersion    Int
  runId          String
  run            Run            @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentVersionId String?
  agentVersion   AgentVersion?  @relation(fields: [agentVersionId], references: [id], onDelete: SetNull)
  injectedAt     DateTime       @default(now())
  evaluation     EvaluationStatus @default(UNCHECKED)
  evidenceRef    String         @default("")
  failureReason  String         @default("")
}
